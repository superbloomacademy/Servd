# Copy this file to .env for local use. On Vercel, enter the same names under
# Project → Settings → Environment Variables. Never commit the real .env (it holds passwords).

# ---- Database
# Empty = built-in local PostgreSQL (this PC only, started automatically, data in .data/pg).
# Vercel: connect a Neon database in Storage; Vercel fills DATABASE_URL in for you (use the pooled URL).
DATABASE_URL=
PORT=3001

# ---- Web address used inside printed QR codes and for secure cookies.
# Empty = this computer's Wi-Fi address (local) or the Vercel project address. Set your domain before printing stickers.
PUBLIC_BASE_URL=

# ---- Live site safety. Set SEED_DEMO=false on the live site: no demo venues, only your admin login.
SEED_DEMO=
ADMIN_PHONE=
ADMIN_PIN=
ADMIN_NAME=

# ---- Customer login OTP emails. Empty EMAIL_PROVIDER = testing mode (OTP shown on screen).
# gmail: send from our own Gmail. EMAIL_PASSWORD is a Google "App password" (16 letters), not the Gmail password.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=Servd
# Only for EMAIL_PROVIDER=smtp (another mail server): SMTP_HOST, SMTP_PORT, SMTP_USER
# Only for EMAIL_PROVIDER=brevo or resend: EMAIL_API_KEY

# ---- Signing key for live-update passes. Any long random text. (Optional: derived from DATABASE_URL if empty.)
APP_SECRET=

# ---- Optional outside timer for background jobs: GET /api/cron/jobs?key=<CRON_SECRET>
CRON_SECRET=

# ---- Our company, printed on the monthly bills we send vendors, and contact buttons on the home page.
PLATFORM_LEGAL_NAME=
PLATFORM_ADDRESS=
PLATFORM_GSTIN=
PLATFORM_UPI_ID=
PLATFORM_CONTACT_PHONE=
PLATFORM_CONTACT_EMAIL=
