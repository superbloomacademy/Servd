{
  "name": "servd-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-venue QR ordering: theaters, restaurants, cafés, food stalls.",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx tests/e2e.ts",
    "test:login": "bash tests/login-email-otp.sh",
    "db:migrate": "tsx scripts/migrate.ts",
    "vercel-build": "tsx scripts/migrate.ts && next build",
    "test:pos": "tsx tests/pos.ts",
    "test:scroll": "node tests/scroll-audit.mjs",
    "test:demo": "tsx tests/demo.ts",
    "test:ux": "node tests/ux.mjs",
    "test:inv": "tsx tests/inventory.ts",
    "test:billing": "node tests/billing.mjs",
    "test:inv-ui": "node tests/inventory-ui.mjs"
  },
  "dependencies": {
    "cross-env": "7.0.3",
    "drizzle-orm": "0.44.7",
    "embedded-postgres": "17.6.0-beta.15",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "nodemailer": "6.10.1",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsx": "4.20.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
